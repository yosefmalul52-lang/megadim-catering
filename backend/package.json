{
  "name": "megadim-catering-backend",
  "version": "1.0.0",
  "description": "Backend API for Megadim Catering website - Premium kosher catering services",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "node --require ts-node/register/transpile-only --test --test-concurrency=1 --test-force-exit --test-reporter=spec src/controllers/*.spec.ts",
    "test:metrics": "node --require ts-node/register/transpile-only --test --test-concurrency=1 --test-force-exit --test-reporter=spec src/controllers/business-metrics.spec.ts src/controllers/dashboard-overview.spec.ts",
    "test:tranzila-contract": "node --require ts-node/register/transpile-only --test --test-concurrency=1 --test-force-exit --test-reporter=spec src/services/tranzila-contract.spec.ts",
    "seed:kitchen-demo": "ts-node --transpile-only scripts/seed-kitchen-demo-orders.ts",
    "reset:kitchen-demo": "ts-node --transpile-only scripts/seed-kitchen-demo-orders.ts --reset",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 200",
    "format": "prettier --write src/**/*.ts",
    "seed": "node seed.js",
    "migrate:shavuot": "ts-node scripts/migrate-shavuot-to-holiday.ts",
    "migrate:shavuot:dry": "ts-node scripts/migrate-shavuot-to-holiday.ts --dry-run"
  },
  "keywords": [
    "catering",
    "kosher",
    "express",
    "typescript",
    "api",
    "nodejs"
  ],
  "author": "Megadim Catering",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.19.1",
    "tsconfig-paths": "^4.2.0",
    "twilio": "^5.10.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
