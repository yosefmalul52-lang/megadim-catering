# ============================================
# Megadim Catering Project - .gitignore
# ============================================

# ============================================
# Dependencies
# ============================================
# Node modules (all directories)
node_modules/
**/node_modules/
frontend/node_modules/
backend/node_modules/
server/node_modules/

# Package locks (optional - some teams commit these)
# package-lock.json
# **/package-lock.json

# ============================================
# Build Outputs
# ============================================
# TypeScript compiled output
#dist/
**/dist/
# backend/dist/  # Commented out for Render deployment - dist needs to be committed
frontend/dist/
out-tsc/
**/out-tsc/

# Build artifacts
*.tsbuildinfo
*.js.map
*.d.ts.map

# ============================================
# Environment & Configuration (SECURITY)
# ============================================
# Environment variables - CRITICAL: Never commit these!
.env
.env.*
!.env.example
**/.env
**/.env.*
backend/.env
frontend/.env
server/.env

# Local QA / verify artifacts (may contain session cookies)
tmp-screenshots/
**/tmp-screenshots/
test-results/
**/test-results/
playwright-report/

# Configuration files with secrets
config/secrets.json
secrets.json
*.secret
*.key

# ============================================
# IDE & Editor Files
# ============================================
# Visual Studio Code
.vscode/
**/.vscode/
*.code-workspace

# IntelliJ IDEA / WebStorm
.idea/
**/.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# ============================================
# Angular Specific
# ============================================
# Angular cache and build
.angular/
**/.angular/
frontend/.angular/
.angular/cache/
.angular/workspace/

# Angular build output
frontend/dist/
frontend/.angular/

# ============================================
# System Files
# ============================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Logs
# ============================================
# Log files
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ============================================
# Testing
# ============================================
# Coverage directory used by tools like istanbul
coverage/
**/coverage/
*.lcov
.nyc_output/

# Jest
.jest/

# ============================================
# Temporary Files
# ============================================
# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ============================================
# Database
# ============================================
# Local database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# ============================================
# TypeScript
# ============================================
# TypeScript incremental compilation
*.tsbuildinfo
tsconfig.tsbuildinfo
**/tsconfig.tsbuildinfo

# ============================================
# Miscellaneous
# ============================================
# OS generated files
Icon?
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.parcel-cache

# Next.js
.next
out

# Nuxt.js
.nuxt
dist

# Storybook build outputs
storybook-static

# Temporary folders
.tmp/
.temp/

# ============================================
# Project Specific
# ============================================
# Server data (if contains sensitive info)
server/data/chats/
server/data/*.json
!server/data/catering-inquiries.json.example

# Compiled JavaScript (if source is TypeScript)
# backend/dist/  # Commented out for Render deployment - dist needs to be committed
frontend/dist/

# Seed scripts output
*.seed.log

